# Service Configuration
PORT=8082
HOST=0.0.0.0
ENVIRONMENT=dev

# EVM Configuration (Base Sepolia)
EVM_RPC_URL=https://sepolia.base.org
CONTRACT_ADDRESS=
PRIVATE_KEY=

# Contract ABI (JSON string - loaded from file in production)
CONTRACT_ABI=[]

# The Graph Subgraph
SUBGRAPH_URL=

# Walrus (Sui Storage)
WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space
WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space

# Sui (testnet)
SUI_RPC=https://fullnode.testnet.sui.io:443
SUI_PACKAGE_ID=0xc5487e68a3c6b4cb5a34992c976017178d52b865580d57943e660208d19abc9b
# Shared Registry object created by the package's init - required to call stamp()
SUI_REGISTRY_ID=0x2ba5935995d77fcae22d4403084a8f949da03ed49fbcad053cbd4df51c9a713e
# Bounds the StampCreated event scan used for Sui lookups
SUI_EVENT_PAGE_SIZE=50
SUI_EVENT_MAX_PAGES=10

# ENS CCIP-Read Gateway
ENS_GATEWAY_URL=

# AI (Claude API)
ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=info
